// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String       @id
  name                String
  email               String
  emailVerified       Boolean      @default(false)
  image               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  phoneNumber         String?
  phoneNumberVerified Boolean?
  // Comma-separated list of role keys (e.g. "super_admin,pastor"). See src/lib/rbac/roles.ts.
  role                String?
  banned              Boolean?     @default(false)
  banReason           String?
  banExpires          DateTime?
  sessions            Session[]
  accounts            Account[]
  commitments         Commitment[]
  unitRoles           UserUnitRole[]
  auditLogs           AuditLog[]   @relation("AuditActor")
  member              Member?
  importJobs          ImportJob[]

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

enum UnitRole {
  MEMBER
  LEADER
  ASSISTANT
}

model UserUnitRole {
  userId String
  unitId String
  role   UnitRole @default(LEADER)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   ChurchUnitOption @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@index([unitId])
  @@map("user_unit_role")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  subject   String
  subjectId String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([subject, subjectId])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================
// MEMBER DIRECTORY
// ============================================

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
}

enum MemberStatus {
  VISITOR
  PENDING_APPROVAL
  REGULAR
  MEMBER
  INACTIVE
  TRANSFERRED
  DECEASED
}

model Member {
  id                 String         @id @default(cuid())
  userId             String?        @unique
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName           String
  preferredName      String?
  dob                DateTime?
  gender             Gender?
  maritalStatus      MaritalStatus?
  email              String?
  phone              String?
  whatsapp           String?
  addressLine        String?
  city               String?
  region             String?
  country            String?        @default("Ghana")
  occupation         String?
  photoUrl           String?
  photoPublicId      String?
  salvationDate      DateTime?
  baptismDate        DateTime?
  weddingAnniversary DateTime?
  joinDate           DateTime?
  status             MemberStatus   @default(VISITOR)
  notes              String?        @db.Text
  notifyByEmail      Boolean        @default(true)
  notifyBySms        Boolean        @default(true)
  householdId        String?
  household          Household?     @relation(fields: [householdId], references: [id], onDelete: SetNull)
  units              MemberUnit[]
  tags               MemberTag[]
  attendance         Attendance[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([dob])
  @@index([householdId])
  @@map("member")
}

model MemberUnit {
  memberId String
  unitId   String
  role     UnitRole  @default(MEMBER)
  since    DateTime?
  member   Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  unit     ChurchUnitOption  @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([memberId, unitId])
  @@index([unitId])
  @@map("member_unit")
}

model Household {
  id          String   @id @default(cuid())
  name        String
  addressLine String?
  city        String?
  region      String?
  notes       String?  @db.Text
  members     Member[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("household")
}

model Tag {
  id      String     @id @default(cuid())
  label   String     @unique
  color   String?
  members MemberTag[]
  createdAt DateTime @default(now())

  @@map("tag")
}

model MemberTag {
  memberId String
  tagId    String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([memberId, tagId])
  @@index([tagId])
  @@map("member_tag")
}

// ============================================
// SERVICES & ATTENDANCE
// ============================================

enum AttendanceMethod {
  MANUAL
  QR
  SELF
}

model Service {
  id         String       @id @default(cuid())
  title      String
  date       DateTime
  location   String?
  notes      String?      @db.Text
  attendance Attendance[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt

  @@index([date])
  @@map("service")
}

model Attendance {
  id          String           @id @default(cuid())
  memberId    String
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  checkedInAt DateTime         @default(now())
  method      AttendanceMethod @default(MANUAL)
  checkedInById String?
  createdAt   DateTime         @default(now())

  @@unique([memberId, serviceId])
  @@index([serviceId])
  @@index([memberId, checkedInAt])
  @@map("attendance")
}

// ============================================
// MESSAGING (email / SMS)
// ============================================

enum MessageChannel {
  EMAIL
  SMS
}

enum BatchStatus {
  QUEUED
  SENDING
  SENT
  PARTIAL
  FAILED
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

model MessageTemplate {
  id        String         @id @default(cuid())
  name      String         @unique
  channel   MessageChannel
  subject   String?
  body      String         @db.Text
  variables String[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt
  batches   MessageBatch[]

  @@map("message_template")
}

model MessageBatch {
  id           String         @id @default(cuid())
  templateId   String?
  template     MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name         String
  channel      MessageChannel
  subject      String?
  body         String         @db.Text
  segmentJson  Json
  status       BatchStatus    @default(QUEUED)
  recipients   Int            @default(0)
  successes    Int            @default(0)
  failures     Int            @default(0)
  createdById  String
  createdAt    DateTime       @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  logs         MessageLog[]

  @@index([createdById])
  @@index([status])
  @@map("message_batch")
}

model MessageLog {
  id          String         @id @default(cuid())
  batchId     String
  batch       MessageBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  memberId    String?
  channel     MessageChannel
  recipient   String
  status      DeliveryStatus @default(QUEUED)
  providerRef String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([batchId])
  @@index([memberId])
  @@map("message_log")
}

// ============================================
// IMPORT JOBS (CSV import wizard)
// ============================================

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ImportJob {
  id           String          @id @default(cuid())
  type         String                              // "member"
  status       ImportJobStatus @default(PENDING)
  total        Int             @default(0)
  processed    Int             @default(0)
  created      Int             @default(0)
  skipped      Int             @default(0)
  failed       Int             @default(0)
  errors       Json?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@index([createdById])
  @@index([status])
  @@map("import_job")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================
// FUNDRAISING DOMAIN MODELS
// ============================================

enum FundingMode {
  SINGLE_SPONSOR
  MULTI_CONTRIBUTOR
}

enum ProjectStatus {
  ACTIVE
  DISABLED
  FULFILLED
}

enum CommitmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum PrayerRequestStatus {
  NEW
  IN_PRAYER
  PRAYED
  ARCHIVED
}

model Project {
  id           String         @id @default(cuid())
  title        String
  description  String         @db.Text
  targetAmount Decimal        @db.Decimal(12, 2)
  fundingMode  FundingMode    @default(MULTI_CONTRIBUTOR)
  status       ProjectStatus  @default(ACTIVE)
  images       ProjectImage[]
  commitments  Commitment[]
  proofUploads ProofUpload[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("project")
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("project_image")
}

model ChurchUnitOption {
  id        String         @id @default(cuid())
  name      String         @unique
  isActive  Boolean        @default(true)
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  userRoles UserUnitRole[]
  members   MemberUnit[]

  @@map("church_unit_option")
}

model Commitment {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  email           String
  phone           String?
  whatsapp        String?
  address         String?          @db.Text
  country         String
  churchUnit      String?
  amountCommitted Decimal          @db.Decimal(12, 2)
  isAnonymous     Boolean          @default(false)
  status          CommitmentStatus @default(PENDING)
  paymentNote      String?          @db.Text
  confirmedAmount  Decimal?         @db.Decimal(12, 2)
  confirmedAt      DateTime?
  internalNote     String?          @db.Text
  paymentIntents  PaymentIntent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([projectId])
  @@index([userId])
  @@map("commitment")
}

model ProofUpload {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  publicId  String
  note      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("proof_upload")
}

model PaymentIntent {
  id           String          @id @default(cuid())
  commitmentId String
  commitment   Commitment      @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  provider     PaymentProvider
  reference    String          @unique
  amount       Decimal         @db.Decimal(12, 2)
  currency     String          @default("GHS")
  status       PaymentStatus   @default(PENDING)
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([commitmentId])
  @@index([reference])
  @@map("payment_intent")
}

// ============================================
// CMS MODELS
// ============================================

model Event {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  category        String
  date            DateTime
  endDate         DateTime?
  time            String
  location        String
  address         String?
  description     String        @db.Text
  bodyJson        Json?
  bodyHtml        String        @db.Text
  isFeatured      Boolean       @default(false)
  registrationUrl String?
  imageUrl        String?
  imagePublicId   String?
  imageAlt        String?
  status          PublishStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, date])
  @@index([category])
  @@map("event")
}

model ContentPage {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String?       @db.Text
  bodyJson       Json?
  bodyHtml       String        @db.Text
  seoTitle       String?
  seoDescription String?       @db.Text
  imageUrl       String?
  imagePublicId  String?
  imageAlt       String?
  status         PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@map("content_page")
}

model HomepageSection {
  id            String        @id @default(cuid())
  key           String        @unique
  eyebrow       String?
  title         String
  bodyJson      Json?
  bodyHtml      String        @db.Text
  ctaLabel      String?
  ctaHref       String?
  imageUrl      String?
  imagePublicId String?
  imageAlt      String?
  order         Int           @default(0)
  status        PublishStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, order])
  @@map("homepage_section")
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  publicId  String   @unique
  altText   String
  caption   String?
  ownerType String?
  ownerId   String?
  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
  @@map("media_asset")
}

model SermonFeature {
  id           String        @id @default(cuid())
  videoId      String
  title        String
  description  String?       @db.Text
  thumbnailUrl String?
  videoUrl     String
  publishedAt  DateTime?
  isFeatured   Boolean       @default(false)
  order        Int           @default(0)
  status       PublishStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, order])
  @@index([videoId])
  @@map("sermon_feature")
}

// ============================================
// PRAYER REQUESTS
// ============================================

model PrayerRequest {
  id          String              @id @default(cuid())
  content     String              @db.Text
  name        String?
  status      PrayerRequestStatus @default(NEW)
  adminNote   String?             @db.Text
  prayedAt    DateTime?
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt

  @@index([status, createdAt])
  @@map("prayer_request")
}
