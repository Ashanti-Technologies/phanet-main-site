// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String          @id
  name                String
  email               String
  emailVerified       Boolean         @default(false)
  image               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  phoneNumber         String?
  phoneNumberVerified Boolean?
  // Comma-separated list of role keys (e.g. "super_admin,pastor"). See src/lib/rbac/roles.ts.
  role                String?
  banned              Boolean?        @default(false)
  banReason           String?
  banExpires          DateTime?
  twoFactorEnabled    Boolean         @default(false)
  lastLoginMethod     String?
  twoFactors          TwoFactor[]
  sessions            Session[]
  accounts            Account[]
  commitments         Commitment[]
  unitRoles           UserUnitRole[]
  auditLogs           AuditLog[]      @relation("AuditActor")
  member              Member?
  importJobs          ImportJob[]
  visitations         Visitation[]    @relation("VisitedBy")
  assignedTasks       FollowUpTask[]  @relation("TaskAssignee")
  createdTasks        FollowUpTask[]  @relation("TaskCreator")
  memberNotes         MemberNote[]    @relation("NoteAuthor")
  createdInvites      MemberInvite[]  @relation("InviteCreator")
  incomesRecorded     Income[]        @relation("IncomeRecordedBy")
  recurringGifts      RecurringGift[]
  expensesRecorded    Expense[]       @relation("ExpenseRecordedBy")
  expensesApproved    Expense[]       @relation("ExpenseApprovedBy")

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

enum UnitRole {
  MEMBER
  LEADER
  ASSISTANT
}

model UserUnitRole {
  userId String
  unitId String
  role   UnitRole         @default(LEADER)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   ChurchUnitOption @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@index([unitId])
  @@map("user_unit_role")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  subject   String
  subjectId String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([subject, subjectId])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================
// MEMBER DIRECTORY
// ============================================

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
}

enum MemberStatus {
  VISITOR
  PENDING_APPROVAL
  REGULAR
  MEMBER
  INACTIVE
  TRANSFERRED
  DECEASED
}

enum NoteVisibility {
  PASTORAL
  GENERAL
}

enum FollowUpTaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum EventRsvpStatus {
  GOING
  CANCELLED
}

enum PhanetLifeStage {
  WORKING_PROFESSIONAL
  TERTIARY_STUDENT
  SHS_STUDENT
}

enum PhanetProfessionalTrack {
  EMPLOYED
  SELF_EMPLOYED
  STUDYING_OVERSEAS
}

enum PhanetRegionalChapter {
  GREATER_ACCRA
  ASHANTI
  DIASPORA
  NORTHERN
  CENTRAL_NORTH
  CENTRAL_SOUTH
  NORTH_EAST
  BONO
  EASTERN
  WESTERN
}

enum PhanetChapterRole {
  EXECUTIVE_MEMBER
  NON_EXECUTIVE_MEMBER
}

model Country {
  id             String          @id
  code           String          @unique
  name           String
  dialCode       String?
  currency       String?
  translations   Json?
  isActive       Boolean         @default(true)
  regions        Region[]
  cities         City[]
  members        Member[]
  eventAttendees EventAttendee[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([name])
  @@map("country")
}

model Region {
  id             String          @id
  countryId      String
  country        Country         @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name           String
  isActive       Boolean         @default(true)
  cities         City[]
  members        Member[]
  eventAttendees EventAttendee[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([countryId])
  @@index([name])
  @@map("region")
}

/// A town or city members and attendees can pick. Seeded from GeoNames
/// (CC BY 4.0) by scripts/import-geonames-cities.ts; coordinates are the
/// place's, never a person's.
model City {
  id             String          @id @default(cuid())
  geonameId      Int?            @unique
  countryId      String
  country        Country         @relation(fields: [countryId], references: [id], onDelete: Cascade)
  regionId       String?
  region         Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  name           String
  /// Lowercased name + Latin-script alternate names (Obuasi → "Obuase").
  searchText     String
  lat            Float
  lng            Float
  population     Int             @default(0)
  isActive       Boolean         @default(true)
  members        Member[]
  eventAttendees EventAttendee[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([countryId])
  @@index([regionId])
  @@map("city")
}

model Member {
  id                 String               @id @default(cuid())
  userId             String?              @unique
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName           String
  preferredName      String?
  dob                DateTime?
  gender             Gender?
  maritalStatus      MaritalStatus?
  email              String?
  phone              String?
  whatsapp           String?
  addressLine        String?
  city               String?
  cityId             String?
  cityRef            City?                @relation(fields: [cityId], references: [id], onDelete: SetNull)
  countryId          String?
  countryRef         Country?             @relation(fields: [countryId], references: [id], onDelete: SetNull)
  regionId           String?
  regionRef          Region?              @relation(fields: [regionId], references: [id], onDelete: SetNull)
  region             String?
  country            String?              @default("Ghana")
  occupation         String?
  bio                String?              @db.Text
  photoUrl           String?
  photoPublicId      String?
  salvationDate      DateTime?
  baptismDate        DateTime?
  weddingAnniversary DateTime?
  joinDate           DateTime?
  status             MemberStatus         @default(VISITOR)
  notes              String?              @db.Text
  notifyByEmail      Boolean              @default(true)
  notifyBySms        Boolean              @default(true)
  householdId        String?
  household          Household?           @relation(fields: [householdId], references: [id], onDelete: SetNull)
  units              MemberUnit[]
  tags               MemberTag[]
  attendance         Attendance[]
  visitations        Visitation[]
  followUpTasks      FollowUpTask[]
  notesList          MemberNote[]
  invites            MemberInvite[]
  eventRsvps         EventRsvp[]
  eventRegistrations EventRegistration[]
  eventAttendances   EventAttendee[]
  phanetProfile      MemberPhanetProfile?
  incomes            Income[]
  paymentIntents     PaymentIntent[]
  recurringGifts     RecurringGift[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([dob])
  @@index([countryId])
  @@index([regionId])
  @@index([cityId])
  @@index([householdId])
  @@map("member")
}

model MemberPhanetProfile {
  id                        String                   @id @default(cuid())
  memberId                  String                   @unique
  member                    Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  formSubmittedAt           DateTime?
  emergencyContactName      String?
  emergencyContactPhone     String?
  lifeStage                 PhanetLifeStage?
  professionalTrack         PhanetProfessionalTrack?
  organizationName          String?
  regionalChapter           PhanetRegionalChapter?
  tertiaryInstitution       String?
  tertiaryProgramme         String?
  tertiaryYear              String?
  tertiaryResidence         String?
  tertiaryChapterRole       PhanetChapterRole?
  tertiaryExecutiveRole     String?
  campusMinistryInvolvement String?                  @db.Text
  shsName                   String?
  shsYear                   String?
  shsProgramme              String?
  shsChapterRole            PhanetChapterRole?
  shsExecutiveRole          String?
  departmentText            String?                  @db.Text
  nationalRole              String?
  overseasProgramme         String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([lifeStage])
  @@index([professionalTrack])
  @@index([regionalChapter])
  @@map("member_phanet_profile")
}

model MemberUnit {
  memberId String
  unitId   String
  role     UnitRole         @default(MEMBER)
  since    DateTime?
  member   Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  unit     ChurchUnitOption @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([memberId, unitId])
  @@index([unitId])
  @@map("member_unit")
}

model Household {
  id          String   @id @default(cuid())
  name        String
  addressLine String?
  city        String?
  region      String?
  notes       String?  @db.Text
  members     Member[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("household")
}

model Tag {
  id        String      @id @default(cuid())
  label     String      @unique
  color     String?
  members   MemberTag[]
  createdAt DateTime    @default(now())

  @@map("tag")
}

model MemberTag {
  memberId String
  tagId    String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([memberId, tagId])
  @@index([tagId])
  @@map("member_tag")
}

// ============================================
// PASTORAL CARE
// ============================================

model Visitation {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  visitedById String
  visitedBy   User     @relation("VisitedBy", fields: [visitedById], references: [id], onDelete: Cascade)
  visitedAt   DateTime
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([memberId, visitedAt])
  @@index([visitedById])
  @@map("visitation")
}

model FollowUpTask {
  id           String             @id @default(cuid())
  memberId     String
  member       Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User               @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User               @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title        String
  notes        String?            @db.Text
  dueAt        DateTime?
  status       FollowUpTaskStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  @@index([memberId])
  @@index([assignedToId, status, dueAt])
  @@index([createdById])
  @@map("follow_up_task")
}

model MemberNote {
  id         String         @id @default(cuid())
  memberId   String
  member     Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  authorId   String
  author     User           @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body       String         @db.Text
  visibility NoteVisibility @default(GENERAL)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt

  @@index([memberId, visibility])
  @@index([authorId])
  @@map("member_note")
}

enum MemberInviteChannel {
  EMAIL
  PHONE
}

model MemberInvite {
  id          String              @id @default(cuid())
  memberId    String              @unique
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash   String              @unique
  email       String
  channel     MemberInviteChannel @default(EMAIL)
  phone       String?
  codeHash    String?
  attempts    Int                 @default(0)
  lastSentAt  DateTime?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdById String?
  createdBy   User?               @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt

  @@index([email])
  @@index([phone])
  @@index([expiresAt])
  @@map("member_invite")
}

// ============================================
// SERVICES & ATTENDANCE
// ============================================

enum AttendanceMethod {
  MANUAL
  QR
  SELF
}

model Service {
  id         String       @id @default(cuid())
  title      String
  date       DateTime
  location   String?
  notes      String?      @db.Text
  attendance Attendance[]
  incomes    Income[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt

  @@index([date])
  @@map("service")
}

model Attendance {
  id            String           @id @default(cuid())
  memberId      String
  member        Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  checkedInAt   DateTime         @default(now())
  method        AttendanceMethod @default(MANUAL)
  checkedInById String?
  createdAt     DateTime         @default(now())

  @@unique([memberId, serviceId])
  @@index([serviceId])
  @@index([memberId, checkedInAt])
  @@map("attendance")
}

// ============================================
// MESSAGING (email / SMS)
// ============================================

enum MessageChannel {
  EMAIL
  SMS
}

enum BatchStatus {
  QUEUED
  SENDING
  SENT
  PARTIAL
  FAILED
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

model MessageTemplate {
  id        String         @id @default(cuid())
  name      String         @unique
  channel   MessageChannel
  subject   String?
  body      String         @db.Text
  variables String[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt
  batches   MessageBatch[]

  @@map("message_template")
}

model MessageBatch {
  id          String           @id @default(cuid())
  templateId  String?
  template    MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name        String
  channel     MessageChannel
  subject     String?
  body        String           @db.Text
  segmentJson Json
  status      BatchStatus      @default(QUEUED)
  recipients  Int              @default(0)
  successes   Int              @default(0)
  failures    Int              @default(0)
  createdById String
  createdAt   DateTime         @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  logs        MessageLog[]

  @@index([createdById])
  @@index([status])
  @@map("message_batch")
}

model MessageLog {
  id          String         @id @default(cuid())
  batchId     String
  batch       MessageBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  memberId    String?
  channel     MessageChannel
  recipient   String
  status      DeliveryStatus @default(QUEUED)
  providerRef String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([batchId])
  @@index([memberId])
  @@map("message_log")
}

// ============================================
// IMPORT JOBS (CSV import wizard)
// ============================================

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ImportJob {
  id          String          @id @default(cuid())
  type        String // "member"
  status      ImportJobStatus @default(PENDING)
  total       Int             @default(0)
  processed   Int             @default(0)
  created     Int             @default(0)
  skipped     Int             @default(0)
  failed      Int             @default(0)
  errors      Json?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@index([createdById])
  @@index([status])
  @@map("import_job")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String @id
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret      String
  backupCodes String

  @@index([userId])
  @@index([secret])
  @@map("two_factor")
}

// ============================================
// FUNDRAISING DOMAIN MODELS
// ============================================

enum FundingMode {
  SINGLE_SPONSOR
  MULTI_CONTRIBUTOR
}

enum ProjectStatus {
  ACTIVE
  DISABLED
  FULFILLED
}

enum CommitmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum PrayerRequestStatus {
  NEW
  IN_PRAYER
  PRAYED
  ARCHIVED
}

model Project {
  id           String         @id @default(cuid())
  title        String
  description  String         @db.Text
  targetAmount Decimal        @db.Decimal(12, 2)
  fundingMode  FundingMode    @default(MULTI_CONTRIBUTOR)
  status       ProjectStatus  @default(ACTIVE)
  images       ProjectImage[]
  commitments  Commitment[]
  proofUploads ProofUpload[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("project")
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("project_image")
}

model ChurchUnitOption {
  id        String         @id @default(cuid())
  name      String         @unique
  isActive  Boolean        @default(true)
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  userRoles UserUnitRole[]
  members   MemberUnit[]
  expenses  Expense[]
  budgets   Budget[]

  @@map("church_unit_option")
}

model Commitment {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  email           String
  phone           String?
  whatsapp        String?
  address         String?          @db.Text
  country         String
  churchUnit      String?
  amountCommitted Decimal          @db.Decimal(12, 2)
  isAnonymous     Boolean          @default(false)
  status          CommitmentStatus @default(PENDING)
  paymentNote     String?          @db.Text
  confirmedAmount Decimal?         @db.Decimal(12, 2)
  confirmedAt     DateTime?
  internalNote    String?          @db.Text
  paymentIntents  PaymentIntent[]
  incomes         Income[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([projectId])
  @@index([userId])
  @@map("commitment")
}

model ProofUpload {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  publicId  String
  note      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("proof_upload")
}

model PaymentIntent {
  id                  String             @id @default(cuid())
  // Set for pledge payments; null for general online giving.
  commitmentId        String?
  commitment          Commitment?        @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  /// Set for event-fee payments.
  eventRegistrationId String?
  eventRegistration   EventRegistration? @relation(fields: [eventRegistrationId], references: [id], onDelete: SetNull)
  fundId              String?
  fund                Fund?              @relation(fields: [fundId], references: [id], onDelete: SetNull)
  memberId            String?
  member              Member?            @relation(fields: [memberId], references: [id], onDelete: SetNull)
  email               String?
  donorName           String?
  /// Set for monthly gifts (the first checkout and every renewal charge).
  recurringGiftId     String?
  recurringGift       RecurringGift?     @relation(fields: [recurringGiftId], references: [id], onDelete: SetNull)
  provider            PaymentProvider
  reference           String             @unique
  amount              Decimal            @db.Decimal(12, 2)
  currency            String             @default("GHS")
  status              PaymentStatus      @default(PENDING)
  metadata            Json?
  income              Income?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([commitmentId])
  @@index([eventRegistrationId])
  @@index([recurringGiftId])
  @@index([reference])
  @@map("payment_intent")
}

enum RecurringGiftStatus {
  // Waiting for the first payment to succeed and give us a reusable card.
  PENDING
  ACTIVE
  // Stopped after repeated failed charges; the giver can set up a new one.
  PAUSED
  CANCELLED
}

// A monthly card gift. Renewals are charged by /api/cron/recurring-giving
// against the saved Paystack authorization, then settled like any gift.
model RecurringGift {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId          String?
  member            Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  fundId            String
  fund              Fund                @relation(fields: [fundId], references: [id])
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("GHS")
  email             String
  donorName         String
  provider          PaymentProvider     @default(PAYSTACK)
  // Paystack reusable card token. Never sent to the browser.
  authorizationCode String?
  cardLabel         String?
  dayOfMonth        Int
  nextChargeAt      DateTime?
  failedAttempts    Int                 @default(0)
  status            RecurringGiftStatus @default(PENDING)
  cancelledAt       DateTime?
  paymentIntents    PaymentIntent[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, nextChargeAt])
  @@index([userId])
  @@map("recurring_gift")
}

// ============================================
// FINANCE LEDGER
// ============================================
// Rows are never hard-deleted: set voidedAt instead, and every report filters
// voidedAt = null. Amounts are GHS for now (currency column kept for later).

enum PaymentMethod {
  CASH
  MOMO
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Fund {
  id             String          @id @default(cuid())
  name           String          @unique
  description    String?
  isActive       Boolean         @default(true)
  incomes        Income[]
  expenses       Expense[]
  paymentIntents PaymentIntent[]
  recurringGifts RecurringGift[]
  /// Events whose fees are recorded into this fund
  events         Event[]
  createdAt      DateTime        @default(now())

  @@map("fund")
}

model Income {
  id                  String             @id @default(cuid())
  fundId              String
  fund                Fund               @relation(fields: [fundId], references: [id])
  amount              Decimal            @db.Decimal(12, 2)
  currency            String             @default("GHS")
  receivedAt          DateTime
  method              PaymentMethod
  // MoMo transaction id, bank reference, cheque number…
  reference           String?
  memberId            String?
  member              Member?            @relation(fields: [memberId], references: [id], onDelete: SetNull)
  // Visitors / non-members, or a label like "Sunday offering".
  donorName           String?
  serviceId           String?
  service             Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  commitmentId        String?
  commitment          Commitment?        @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  paymentIntentId     String?            @unique
  paymentIntent       PaymentIntent?     @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  /// Event fee: keeps EventRegistration.amountPaid in sync (see syncRegistrationPayment).
  eventRegistrationId String?
  eventRegistration   EventRegistration? @relation(fields: [eventRegistrationId], references: [id], onDelete: SetNull)
  note                String?            @db.Text
  // Null for gifts settled automatically by a payment provider.
  recordedById        String?
  recordedBy          User?              @relation("IncomeRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedAt            DateTime?
  voidReason          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([fundId, receivedAt])
  @@index([receivedAt])
  @@index([memberId])
  @@index([serviceId])
  @@index([commitmentId])
  @@index([eventRegistrationId])
  @@map("income")
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  expenses  Expense[]
  budgets   Budget[]
  createdAt DateTime  @default(now())

  @@map("expense_category")
}

// Spending plan for a period. Null category / unit = any. Actual spend is
// computed from PAID, non-voided expenses — never stored.
model Budget {
  id           String            @id @default(cuid())
  name         String
  categoryId   String?
  category     ExpenseCategory?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  churchUnitId String?
  churchUnit   ChurchUnitOption? @relation(fields: [churchUnitId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  // Inclusive (whole day).
  periodEnd    DateTime
  amount       Decimal           @db.Decimal(12, 2)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([periodStart, periodEnd])
  @@map("budget")
}

model Expense {
  id           String            @id @default(cuid())
  categoryId   String
  category     ExpenseCategory   @relation(fields: [categoryId], references: [id])
  fundId       String?
  fund         Fund?             @relation(fields: [fundId], references: [id], onDelete: SetNull)
  churchUnitId String?
  churchUnit   ChurchUnitOption? @relation(fields: [churchUnitId], references: [id], onDelete: SetNull)
  amount       Decimal           @db.Decimal(12, 2)
  currency     String            @default("GHS")
  payee        String
  description  String            @db.Text
  incurredAt   DateTime
  method       PaymentMethod?
  reference    String?
  receiptUrl   String?
  status       ExpenseStatus     @default(PENDING)
  recordedById String
  recordedBy   User              @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  approvedById String?
  approvedBy   User?             @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  paidAt       DateTime?
  voidedAt     DateTime?
  voidReason   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([incurredAt])
  @@index([status])
  @@index([categoryId])
  @@index([churchUnitId])
  @@map("expense")
}

// ============================================
// CMS MODELS
// ============================================

model Event {
  id                   String              @id @default(cuid())
  slug                 String              @unique
  title                String
  category             String
  date                 DateTime
  endDate              DateTime?
  time                 String
  location             String
  address              String?
  description          String              @db.Text
  bodyJson             Json?
  bodyHtml             String              @db.Text
  isFeatured           Boolean             @default(false)
  registrationUrl      String?
  imageUrl             String?
  imagePublicId        String?
  imageAlt             String?
  /// Optional hero background on the public event page
  headerImageUrl       String?
  headerImagePublicId  String?
  status               PublishStatus       @default(DRAFT)
  type                 EventType           @default(MEETING)
  registrationEnabled  Boolean             @default(false)
  registrationClosesAt DateTime?
  /// Admin-built registration form; shape: eventRegistrationFieldsSchema
  registrationFields   Json?
  /// People may register to follow online instead of attending in person
  allowOnline          Boolean             @default(false)
  paymentMode          EventPaymentMode    @default(FREE)
  /// Ledger fund for this event's fees (PAY_AT_EVENT / ONLINE)
  feeFundId            String?
  feeFund              Fund?               @relation(fields: [feeFundId], references: [id], onDelete: SetNull)
  priceTiers           EventPriceTier[]
  rsvps                EventRsvp[]
  registrations        EventRegistration[]
  attendees            EventAttendee[]
  roomTypes            EventRoomType[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status, date])
  @@index([category])
  @@map("event")
}

model EventRsvp {
  id        String          @id @default(cuid())
  memberId  String
  member    Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status    EventRsvpStatus @default(GOING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  @@unique([memberId, eventId])
  @@index([eventId, status])
  @@index([memberId, status])
  @@map("event_rsvp")
}

// ============================================
// EVENT REGISTRATION (camps & meetings)
// ============================================

enum EventType {
  MEETING
  CAMP
}

enum EventRegistrationStatus {
  CONFIRMED
  /// ONLINE events: held until Paystack confirms payment
  PENDING_PAYMENT
  CANCELLED
}

enum EventPaymentMode {
  /// No fee
  FREE
  /// Fees shown publicly; nothing tracked
  DISPLAY_ONLY
  /// Booking confirmed; amount owed until desk staff record payment
  PAY_AT_EVENT
  /// Booking held as PENDING_PAYMENT until Paystack confirms
  ONLINE
}

/// Admin-defined price category (e.g. "Tertiary student", "Working class").
model EventPriceTier {
  id          String          @id @default(cuid())
  eventId     String
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  amount      Decimal         @db.Decimal(12, 2)
  sortOrder   Int             @default(0)
  attendees   EventAttendee[]
  createdAt   DateTime        @default(now())

  @@unique([eventId, name])
  @@map("event_price_tier")
}

enum AttendeeRelationship {
  SELF
  SPOUSE
  CHILD
  RELATIVE
  GUEST
}

enum AttendanceMode {
  IN_PERSON
  ONLINE
}

enum AgeGroup {
  ADULT
  TEEN
  CHILD
  INFANT
}

/// One booking, filled in by `registrant` for themselves and/or others.
model EventRegistration {
  id             String                  @id @default(cuid())
  eventId        String
  event          Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrantId   String
  registrant     Member                  @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  status         EventRegistrationStatus @default(CONFIRMED)
  /// Answers to booking-scoped form fields, keyed by field id.
  answers        Json?
  attendees      EventAttendee[]
  /// Sum of attendee price snapshots
  amountDue      Decimal                 @default(0) @db.Decimal(12, 2)
  /// Sum of non-voided linked incomes (syncRegistrationPayment)
  amountPaid     Decimal                 @default(0) @db.Decimal(12, 2)
  paidAt         DateTime?
  incomes        Income[]
  paymentIntents PaymentIntent[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([eventId, registrantId])
  @@index([eventId, status])
  @@map("event_registration")
}

/// One person on a booking. Every attendee is a Member row (VISITOR if new).
model EventAttendee {
  id             String               @id @default(cuid())
  registrationId String
  registration   EventRegistration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  relationship   AttendeeRelationship
  ageGroup       AgeGroup?
  priceTierId    String?
  priceTier      EventPriceTier?      @relation(fields: [priceTierId], references: [id], onDelete: SetNull)
  /// Snapshots at booking time, so later tier edits don't change what's owed
  tierName       String?
  amount         Decimal?             @db.Decimal(12, 2)
  /// Answers to person-scoped form fields, keyed by field id.
  answers        Json?
  roomId         String?
  room           EventRoom?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  checkedInAt    DateTime?
  attendance     AttendanceMode       @default(IN_PERSON)
  /// Where the person is, as given at booking time (snapshot for analytics)
  countryId      String?
  country        Country?             @relation(fields: [countryId], references: [id], onDelete: SetNull)
  regionId       String?
  region         Region?              @relation(fields: [regionId], references: [id], onDelete: SetNull)
  cityId         String?
  cityRef        City?                @relation(fields: [cityId], references: [id], onDelete: SetNull)
  /// City name (also set when the town wasn't in our list)
  city           String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([eventId, memberId])
  @@index([registrationId])
  @@index([roomId])
  @@index([eventId, attendance])
  @@index([countryId])
  @@map("event_attendee")
}

model EventRoomType {
  id          String      @id @default(cuid())
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  rooms       EventRoom[]
  createdAt   DateTime    @default(now())

  @@unique([eventId, name])
  @@map("event_room_type")
}

model EventRoom {
  id         String          @id @default(cuid())
  roomTypeId String
  roomType   EventRoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name       String
  beds       Int
  /// Restrict to one gender; null = mixed / family room.
  gender     Gender?
  attendees  EventAttendee[]
  createdAt  DateTime        @default(now())

  @@unique([roomTypeId, name])
  @@map("event_room")
}

model ContentPage {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String?       @db.Text
  bodyJson       Json?
  bodyHtml       String        @db.Text
  seoTitle       String?
  seoDescription String?       @db.Text
  imageUrl       String?
  imagePublicId  String?
  imageAlt       String?
  status         PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@map("content_page")
}

model HomepageSection {
  id            String        @id @default(cuid())
  key           String        @unique
  eyebrow       String?
  title         String
  bodyJson      Json?
  bodyHtml      String        @db.Text
  ctaLabel      String?
  ctaHref       String?
  imageUrl      String?
  imagePublicId String?
  imageAlt      String?
  order         Int           @default(0)
  status        PublishStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, order])
  @@map("homepage_section")
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  publicId  String   @unique
  altText   String
  caption   String?
  ownerType String?
  ownerId   String?
  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
  @@map("media_asset")
}

model SermonFeature {
  id           String        @id @default(cuid())
  videoId      String
  title        String
  description  String?       @db.Text
  thumbnailUrl String?
  videoUrl     String
  publishedAt  DateTime?
  isFeatured   Boolean       @default(false)
  order        Int           @default(0)
  status       PublishStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, order])
  @@index([videoId])
  @@map("sermon_feature")
}

// ============================================
// PRAYER REQUESTS
// ============================================

model PrayerRequest {
  id         String              @id @default(cuid())
  content    String              @db.Text
  name       String?
  email      String?
  phone      String?
  status     PrayerRequestStatus @default(NEW)
  adminNote  String?             @db.Text
  prayedAt   DateTime?
  archivedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
  @@map("prayer_request")
}
