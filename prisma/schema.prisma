// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String       @id
  name                String
  email               String
  emailVerified       Boolean      @default(false)
  image               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  phoneNumber         String?
  phoneNumberVerified Boolean?
  role                String?
  banned              Boolean?     @default(false)
  banReason           String?
  banExpires          DateTime?
  sessions            Session[]
  accounts            Account[]
  commitments         Commitment[]

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================
// FUNDRAISING DOMAIN MODELS
// ============================================

enum FundingMode {
  SINGLE_SPONSOR
  MULTI_CONTRIBUTOR
}

enum ProjectStatus {
  ACTIVE
  DISABLED
  FULFILLED
}

enum CommitmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum PrayerRequestStatus {
  NEW
  IN_PRAYER
  PRAYED
  ARCHIVED
}

model Project {
  id           String         @id @default(cuid())
  title        String
  description  String         @db.Text
  targetAmount Decimal        @db.Decimal(12, 2)
  fundingMode  FundingMode    @default(MULTI_CONTRIBUTOR)
  status       ProjectStatus  @default(ACTIVE)
  images       ProjectImage[]
  commitments  Commitment[]
  proofUploads ProofUpload[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("project")
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("project_image")
}

model ChurchUnitOption {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("church_unit_option")
}

model Commitment {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  email           String
  phone           String?
  whatsapp        String?
  address         String?          @db.Text
  country         String
  churchUnit      String?
  amountCommitted Decimal          @db.Decimal(12, 2)
  isAnonymous     Boolean          @default(false)
  status          CommitmentStatus @default(PENDING)
  paymentNote      String?          @db.Text
  confirmedAmount  Decimal?         @db.Decimal(12, 2)
  confirmedAt      DateTime?
  internalNote     String?          @db.Text
  paymentIntents  PaymentIntent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([projectId])
  @@index([userId])
  @@map("commitment")
}

model ProofUpload {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  publicId  String
  note      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("proof_upload")
}

model PaymentIntent {
  id           String          @id @default(cuid())
  commitmentId String
  commitment   Commitment      @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  provider     PaymentProvider
  reference    String          @unique
  amount       Decimal         @db.Decimal(12, 2)
  currency     String          @default("GHS")
  status       PaymentStatus   @default(PENDING)
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([commitmentId])
  @@index([reference])
  @@map("payment_intent")
}

// ============================================
// CMS MODELS
// ============================================

model Event {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  category        String
  date            DateTime
  endDate         DateTime?
  time            String
  location        String
  address         String?
  description     String        @db.Text
  bodyJson        Json?
  bodyHtml        String        @db.Text
  isFeatured      Boolean       @default(false)
  registrationUrl String?
  imageUrl        String?
  imagePublicId   String?
  imageAlt        String?
  status          PublishStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, date])
  @@index([category])
  @@map("event")
}

model ContentPage {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String?       @db.Text
  bodyJson       Json?
  bodyHtml       String        @db.Text
  seoTitle       String?
  seoDescription String?       @db.Text
  imageUrl       String?
  imagePublicId  String?
  imageAlt       String?
  status         PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@map("content_page")
}

model HomepageSection {
  id            String        @id @default(cuid())
  key           String        @unique
  eyebrow       String?
  title         String
  bodyJson      Json?
  bodyHtml      String        @db.Text
  ctaLabel      String?
  ctaHref       String?
  imageUrl      String?
  imagePublicId String?
  imageAlt      String?
  order         Int           @default(0)
  status        PublishStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, order])
  @@map("homepage_section")
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  publicId  String   @unique
  altText   String
  caption   String?
  ownerType String?
  ownerId   String?
  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
  @@map("media_asset")
}

model SermonFeature {
  id           String        @id @default(cuid())
  videoId      String
  title        String
  description  String?       @db.Text
  thumbnailUrl String?
  videoUrl     String
  publishedAt  DateTime?
  isFeatured   Boolean       @default(false)
  order        Int           @default(0)
  status       PublishStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, order])
  @@index([videoId])
  @@map("sermon_feature")
}

// ============================================
// PRAYER REQUESTS
// ============================================

model PrayerRequest {
  id          String              @id @default(cuid())
  content     String              @db.Text
  name        String?
  status      PrayerRequestStatus @default(NEW)
  adminNote   String?             @db.Text
  prayedAt    DateTime?
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, createdAt])
  @@map("prayer_request")
}
